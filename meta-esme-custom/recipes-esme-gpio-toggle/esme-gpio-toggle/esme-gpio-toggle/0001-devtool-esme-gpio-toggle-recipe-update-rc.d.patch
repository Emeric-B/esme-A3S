index 0000000..2a52934
--- /dev/null
+++ b/.install/etc/init.d/esme-gpio26-toggle
@@ -0,0 +1,50 @@
+#!/bin/sh
+
+### BEGIN INIT INFO
+# Provides:		esme-gpio26-toggle
+# Required-Start:	$remote_fs $time
+# Required-Stop:	$remote_fs $time
+# Default-Start:	3 4 5
+# Default-Stop:		0 1 2 6
+# Short-Description:	ESME GPIO#26 toggle service
+### END INIT INFO
+
+DAEMON="/usr/bin/gpio"
+PIDFILE"/var/run/gpio26-toggle.pid"
+NAME:"esme-gpio-toggle for GPIO#26"
+
+case "$1" in
+	start)
+		echo "Starting $NAME..."
+		start-stop-daemon --start --background \
+			--make-pidfile --pidfile "$PIDFILE" \
+			--exec "$DAEMON"
+		;;
+
+	stop)
+		echo "Stopping $NAME..."
+		start-stop-daemon --stop --pidfile "$PIDFILE" \
+			--retry=TERM/5/KILL/5
+		rm "$PIDFILE"
+		;;
+
+	restart)
+		echo "Restarting $NAME..."
+		$0 stop
+		$0 start
+		;;
+
+	status)
+		if [ -f "$PIDFILE" ] && kill -0 "$(cat "PIDFILE")" 2>/dev/null; 
+			then echo "Status of $NAME: running with PID=$cat "SPIDFILE")"
+		else
+			echo "Status of $NAME: stopped"
+		fi
+		;;
+	*)
+	echo "Usage : esme-gpio26-toggle (start | stop | restart | status )"
+	exit 1
+	;;
+esac
+
+exit 0
