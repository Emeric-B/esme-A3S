 .install/etc/init.d/esme-gpio26-toggle |   8 ++++----
 .install/usr/bin/esme-gpio-toggle      | Bin 16392 -> 16392 bytes
 esme-gpio-toggle                       | Bin 13936 -> 13936 bytes
 esme-gpio26-toggle                     |   8 ++++----
 gpio.c                                 |   2 +-
 5 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/.install/etc/init.d/esme-gpio26-toggle b/.install/etc/init.d/esme-gpio26-toggle
index 2a52934..bca35b0 100755
--- a/.install/etc/init.d/esme-gpio26-toggle
+++ b/.install/etc/init.d/esme-gpio26-toggle
@@ -10,8 +10,8 @@
 ### END INIT INFO
 
 DAEMON="/usr/bin/gpio"
-PIDFILE"/var/run/gpio26-toggle.pid"
-NAME:"esme-gpio-toggle for GPIO#26"
+PIDFILE="/var/run/gpio26-toggle.pid"
+NAME="esme-gpio-toggle for GPIO#26"
 
 case "$1" in
 	start)
@@ -35,8 +35,8 @@ case "$1" in
 		;;
 
 	status)
-		if [ -f "$PIDFILE" ] && kill -0 "$(cat "PIDFILE")" 2>/dev/null; 
-			then echo "Status of $NAME: running with PID=$cat "SPIDFILE")"
+		if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; 
+			then echo "Status of $NAME: running with PID=$(cat "SPIDFILE")"
 		else
 			echo "Status of $NAME: stopped"
 		fi
